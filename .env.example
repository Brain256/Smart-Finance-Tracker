INBOUND_SECRET_TOKEN=replace-with-a-32-byte-random-token
# Read by both runtimes: FastAPI for classification, Next.js for the chat assistant.
# Never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=replace-with-groq-api-key
# Notification classification model.
GROQ_MODEL=openai/gpt-oss-20b
# Chat assistant model, kept separate so the two are tunable independently.
CHAT_GROQ_MODEL=openai/gpt-oss-120b
# Shared server-side financial calendar and low-confidence review boundary.
FINANCE_TIMEZONE=America/Toronto
REVIEW_THRESHOLD=0.70
GEMINI_API_KEY=replace-with-gemini-api-key
AUTH_SECRET=replace-with-auth-secret
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret
AUTH_ALLOWED_EMAIL=replace-with-email
SUPABASE_URL=replace-with-supabase-url
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
